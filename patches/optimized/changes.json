          "start": 105,
          "end": 107,
          "lines": [
            "    for (int i = 0; i < SHADOW_FILTER_SAMPLES; i++) {",
            "        // 5 点模式取中心与四个轴向点，保持采样关于中心对称；9 点保留原版。",
            "        #if SHADOW_FILTER_SAMPLES == 5",
            "        int sampleIndex = i == 0 ? 0 : i * 2 - 1;",
            "        #else",
            "        int sampleIndex = i;",
            "        #endif",
            "        vec2 shadowOffset = shadowOffsets[sampleIndex] * offset;"
          ]
